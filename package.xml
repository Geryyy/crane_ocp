<?xml version="1.0"?>
<package format="3">
  <name>crane_ocp</name>
  <version>0.1.0</version>
  <description>
    The acados layer, once: the Python export boilerplate every exporter in this
    stack repeats. Builds nothing -- the C++ binding went with issue 135.
  </description>
  <maintainer email="maintainers@example.invalid">Architecture maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <!-- `scripts/crane_ocp_export.py` reaches acados through `acados_template` off
       the image's interpreter, not through CMake: no rosdep key resolves this
       and nothing here find_packages it. Same resolution crane_mpc and
       crane_planning already record. -->
  <exec_depend>acados</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
